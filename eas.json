{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "projectRoot": "frontend/mobile"
    },
    "preview": {
      "distribution": "internal",
      "projectRoot": "frontend/mobile",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pantrix-backend-12aa.onrender.com/api/v1"
      }
    },
    "production": {
      "projectRoot": "frontend/mobile",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pantrix-backend-12aa.onrender.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
